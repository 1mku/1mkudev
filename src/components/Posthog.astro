<script>
    import posthog from 'posthog-js';
    import type { ConfigDefaults } from 'posthog-js';

    const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY;
    const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST;
    const defaults = import.meta.env.PUBLIC_POSTHOG_DEFAULTS;

    if (import.meta.env.PROD && apiKey && apiHost && defaults) {
        posthog.init(apiKey, {
            api_host: apiHost,
            defaults: defaults as ConfigDefaults,
        });
    }
</script>
