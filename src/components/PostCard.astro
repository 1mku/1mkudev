---
import Card from '@/components/Card.astro';

interface Props {
    title: string;
    href: string;
}

const { href, title } = Astro.props;
---

<li class="link-card">
    <Card>
        <a href={href}>
            <h2>
                {title}
                <span>&rarr;</span>
            </h2>
        </a>
    </Card>
</li>
